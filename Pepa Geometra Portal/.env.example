SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=project-documents

# URL pubblico del portale usata nei link dentro le email.
APP_PUBLIC_URL=https://tuo-portale.example.com

# Email reali. Usa uno tra: brevo, resend, sendgrid.
# Per sviluppo locale puoi usare "console" per vedere l'email nel terminale senza inviarla.
EMAIL_PROVIDER=brevo
EMAIL_FROM=inbolla.web@gmail.com
EMAIL_FROM_NAME=InBolla
BREVO_API_KEY=your-brevo-api-key
# RESEND_API_KEY=your-resend-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key
